# Copy this file to ".env" and change the values if needed.

# Port the Express server listens on
PORT=5000

# Secret key used to sign JWT tokens (use any long random string)
JWT_SECRET=change_this_to_a_long_random_secret

# Frontend URL allowed by CORS
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Database name inside the cluster (optional, this is the default)
DB_NAME=internship_portal
